@{
    ViewData["Title"] = "URL Shortener";
}


<div class="text-center">
    <h1 class="display-4">Welcome</h1>
</div>
<div class="container-table"> 
    <form asp-action="AddShortUrl" method="post">
        <div class="mb3 mt-3">
            <label for="basic-url" class="form-label">Enter your URL: </label>
            <div class="input-group">
                <span class="input-group-text" id="basic-addon1"><i class="fa fa-link" aria-hidden="true"></i></span>
                <input type="url" class="form-control" id="url" name="url" required placeholder="URL" aria-label="UrlLink" aria-describedby="basic-addon1">

                <div class="input-group-append">
                    <button class="btn btn-outline-secondary" type="submit" id="button-addon2">shorten URL</button>
                </div>
            </div>

        </div>
    </form>



    @if (ViewBag.model != null)
    {
        <div class="mt-3 text-center">
            <p>Your shortened URL is: <a href="@ViewBag.model.OriginalUrl">@ViewBag.model.ShortUrl</a></p>
        </div>
    }
</div>

